# Public values only. They end up in the browser bundle.
# Supabase: Project URL + the publishable key (sb_publishable_…) or the legacy anon key.
# Never the secret / service_role key. VITE_SUPABASE_PUBLISHABLE_KEY is accepted as an alias.
# Both empty → the app runs on local demo adapters. See docs/plan/runbook-supabase.md.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web)
VITE_GOOGLE_CLIENT_ID=
# Office feed: sim (default) | replay | none (no simulator: empty office, see docs/plan/removing-the-simulator.md)
VITE_FEED=
